{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=pflege;Username=pflege;Password=pflege_dev"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  // Mailpit from docker-compose catches all mail; web UI on http://localhost:8025
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "From": "webseite@pflegedienst.test",
    "To": "anfragen@pflegedienst.test"
  },
  // Placeholder until the client defines the retention period (docs/OFFENE-PUNKTE.md)
  "Retention": {
    "RequestRetentionDays": 90,
    "ApplicationRetentionDays": 180
  },
  // Local only; in production a persistent, backed-up volume outside the web root
  "Storage": {
    "ApplicationFilesPath": "../../.data/application-files"
  }
}
